<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <worksheet-extension id="com.vizdj.tic.small-multiples-lines" extension-version="0.3">
    <default-locale>en_US</default-locale>
    <name>TIC Small Multiples (bars with variance)</name>
    <description>One small bar chart per member of a dimension, all on the same axes, with each bar's variance against a target or prior period in green (good) and red (bad). Built for The Insights Collective AI Accelerator. Hosted on GitHub Pages.</description>
    <author name="VizDJ" email="SteveA@vizdj.com" organization="VizDJ" website="https://vizdj.com"/>
    <min-api-version>1.12</min-api-version>
    <source-location>
      <url>https://vizdj.github.io/TheInsightsCollective-toolkit/extensions/small-multiples/index.html</url>
    </source-location>
    <icon></icon>
    <encoding id="date">
      <display-name>Bars</display-name>
      <data-spec>
        <data-type>temporal</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
    </encoding>
    <encoding id="measure">
      <display-name>Value</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
    </encoding>
    <encoding id="compare">
      <display-name>Compare to</display-name>
      <data-spec>
        <data-type>numeric</data-type>
      </data-spec>
      <role-spec>
        <role-type>continuous-measure</role-type>
      </role-spec>
      <fields max-count="1"/>
    </encoding>
    <encoding id="panel">
      <display-name>Panel by</display-name>
      <data-spec>
        <data-type>string</data-type>
      </data-spec>
      <role-spec>
        <role-type>discrete-dimension</role-type>
      </role-spec>
      <fields max-count="1"/>
    </encoding>
  </worksheet-extension>
</manifest>
